<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rename Document"
        android:textColor="@color/netra_text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter a clear, recognizable name for this medical document."
        android:textColor="@color/netra_text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etDocumentNewName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_netra_edittext"
        android:hint="e.g. Comprehensive Metabolic Panel July 2026"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/netra_text_primary"
        android:textSize="14sp" />

</LinearLayout>

