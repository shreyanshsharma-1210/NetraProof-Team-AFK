<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_step1b_emergency_contacts.xml — NetraProof Onboarding Step 1b: Trusted Circle
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/netra_bg"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="145dp"
                android:layout_height="36dp"
                android:src="@drawable/app_header_logo"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:contentDescription="NetraProof Logo" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2 / 3"
                android:textColor="@color/netra_primary_teal"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_netra_pill_teal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trusted Emergency Circle"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/netra_deep_navy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="During critical diabetic crises or SOS triggers, NetraProof automatically dispatches live GPS location and health metrics to your trusted contacts."
            android:textColor="@color/netra_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_netra_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <!-- Contact 1 (Primary) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Contact 1 (Primary Emergency Guardian)"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/netra_primary_teal" />
            
            <EditText
                android:id="@+id/et_contact1_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Full Name (e.g., Ramesh Sharma)"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="6dp"/>

            <EditText
                android:id="@+id/et_contact1_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Phone Number (+91 ...)"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="phone"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"/>

            <!-- Contact 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Contact 2 (Optional)"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/netra_text_secondary"/>
            
            <EditText
                android:id="@+id/et_contact2_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Full Name"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="6dp"/>

            <EditText
                android:id="@+id/et_contact2_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Phone Number"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="phone"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"/>

            <!-- Contact 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Contact 3 (Optional Doctor / Hospital)"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/netra_text_secondary"/>
            
            <EditText
                android:id="@+id/et_contact3_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Full Name"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="6dp"/>

            <EditText
                android:id="@+id/et_contact3_phone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Phone Number"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="phone"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_next_step1b"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Continue to Medical History ❯"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/netra_primary_teal"/>

    </LinearLayout>
</ScrollView>
