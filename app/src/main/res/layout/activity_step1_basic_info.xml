<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_step1_basic_info.xml — NetraProof Onboarding Step 1: Basic Identity & Demographics
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/netra_bg">

    <!-- Header Logo & Step Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="145dp"
            android:layout_height="36dp"
            android:src="@drawable/app_header_logo"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="NetraProof Logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 / 3"
            android:textColor="@color/netra_primary_teal"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_netra_pill_teal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Your Medical Profile"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/netra_deep_navy"
        android:letterSpacing="-0.01" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your vital demographics power NetraProof's AI retinal screening, organ risk models, and instant emergency triage."
        android:textColor="@color/netra_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_netra_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <!-- Profile Photo Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="18dp">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_avatar_circle">

                    <ImageView
                        android:id="@+id/iv_profile_photo"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_blank_profile"
                        android:scaleType="centerCrop"
                        android:contentDescription="Profile Photo" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_upload_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 Upload Photo"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/netra_deep_navy"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/et_full_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:hint="Aditya Sharma"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="14dp"/>

            <!-- Date of Birth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date of Birth"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/netra_deep_navy"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:id="@+id/tv_dob"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="14dp"
                android:gravity="center_vertical"
                android:hint="📅 Select Date of Birth"
                android:textColor="@color/netra_deep_navy"
                android:textColorHint="@color/netra_text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="14dp"/>

            <!-- Gender -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/netra_deep_navy"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinner_gender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="14dp"/>

            <!-- Blood Group -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blood Group (Crucial for SOS Transfusion)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinner_blood_group"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_netra_search"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_next_step1"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Continue to Emergency Contacts ❯"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/netra_primary_teal" />

</LinearLayout>
