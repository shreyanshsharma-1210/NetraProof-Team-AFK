<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter Lipid Panel Measurements"
            android:textColor="@color/netra_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter any available numbers from your lab report. Unprovided fields will be kept unrecorded."
            android:textColor="@color/netra_text_secondary"
            android:textSize="11.5sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Total Cholesterol & LDL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Cholesterol"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTotalCholesterol"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 180"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LDL Cholesterol"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLdl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 95"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- HDL & Triglycerides -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HDL Cholesterol"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etHdl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 48"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triglycerides"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTriglycerides"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 140"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Unit & Test Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Measurement Unit"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLipidUnit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="mg/dL"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Test Date *"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLipidDatePicked"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laboratory Name (Optional)"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etLipidLabName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. LabCorp, Quest, Thyrocare"
            android:textColor="@color/netra_text_primary"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clinical Notes (Optional)"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etLipidNotes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. Fasting 12 hours"
            android:textColor="@color/netra_text_primary"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>

