<?xml version="1.0" encoding="utf-8"?>
<!--
    item_schedule_timeline.xml
    Timeline-style medication schedule row for the Medication Dashboard.
    Structure:
      [TIME col] | [DOT+LINE col] | [MEDICATION CARD]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ── TIME COLUMN ───────────────────────────────────── -->
    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top|end"
        android:paddingEnd="8dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tvScheduleTimeHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"
            android:textColor="#0D2140"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/tvScheduleTimeAmPm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AM"
            android:textColor="#9BA9B8"
            android:textSize="10sp"
            android:gravity="end"
            android:layout_marginTop="1dp" />

    </LinearLayout>

    <!-- ── TIMELINE INDICATOR (dot + line) ──────────────── -->
    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="13dp">

        <!-- Status dot -->
        <View
            android:id="@+id/viewTimelineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_status_chip_taken" />

        <!-- Connecting line -->
        <View
            android:id="@+id/viewTimelineLine"
            android:layout_width="2dp"
            android:layout_height="80dp"
            android:background="#E8ECF2"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- ── MEDICATION CARD ───────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Row 1: Drug image + name/dose + overflow menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Drug icon/image placeholder -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_med_summary_scheduled">

                <ImageView
                    android:id="@+id/ivMedIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_medication"
                    app:tint="#087F68" />

            </FrameLayout>

            <!-- Name + dosage column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tvMedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medication Name"
                    android:textColor="#0D2140"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvMedDosage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500mg — 1 tablet"
                    android:textColor="#687790"
                    android:textSize="11.5sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Overflow menu -->
            <ImageView
                android:id="@+id/ivMedOverflow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_more_vert"
                android:padding="6dp"
                app:tint="#9BA9B8"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="More options" />

        </LinearLayout>

        <!-- Row 2: Admin chip + Status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- Administration instruction chip -->
            <TextView
                android:id="@+id/tvAdminChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍽 Take with food"
                android:textColor="#087F68"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_med_admin_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status chip -->
            <TextView
                android:id="@+id/tvStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◷ Pending"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_chip_pending"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
