<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Test Type *"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerTestType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_search"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Measured Value *"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMeasurementValue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="numberDecimal"
                    android:hint="e.g. 95.0"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etMeasurementUnit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. mg/dL"
                    android:textColor="@color/netra_text_primary"
                    android:background="@drawable/bg_netra_search"
                    android:padding="12dp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Date *"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvTestDatePicked"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measurement Source"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerSource"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_search"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laboratory Name (Optional)"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etLabName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="e.g. Quest Diagnostics, Metropolis"
            android:textColor="@color/netra_text_primary"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clinical Notes (Optional)"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="e.g. Fasting sample, requested by Dr. Patel"
            android:textColor="@color/netra_text_primary"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:gravity="top|start"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAttachmentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/netra_primary_teal"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>

