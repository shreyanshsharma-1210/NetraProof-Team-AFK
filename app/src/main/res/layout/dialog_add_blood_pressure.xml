<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blood Pressure Reading (mmHg) *"
        android:textColor="@color/netra_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Systolic (Upper)"
                android:textColor="@color/netra_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etSystolic"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:hint="e.g. 120"
                android:textColor="@color/netra_text_primary"
                android:background="@drawable/bg_netra_search"
                android:padding="12dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/"
            android:textColor="@color/netra_text_secondary"
            android:textSize="24sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_gravity="center_vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diastolic (Lower)"
                android:textColor="@color/netra_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etDiastolic"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:hint="e.g. 80"
                android:textColor="@color/netra_text_primary"
                android:background="@drawable/bg_netra_search"
                android:padding="12dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Measurement Date &amp; Time *"
        android:textColor="@color/netra_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/tvBpDatePicked"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_netra_search"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:textColor="@color/netra_text_primary"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Measurement Source"
        android:textColor="@color/netra_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <Spinner
        android:id="@+id/spinnerBpSource"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_netra_search"
        android:padding="8dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes (Optional)"
        android:textColor="@color/netra_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etBpNotes"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="e.g. Measured seated, after 5 min rest"
        android:textColor="@color/netra_text_primary"
        android:background="@drawable/bg_netra_search"
        android:padding="12dp"
        android:layout_marginTop="4dp" />

</LinearLayout>

