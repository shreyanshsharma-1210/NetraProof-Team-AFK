<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_netra_card"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Dimension Name -->
        <TextView
            android:id="@+id/tvDimensionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dimension Name"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Dimension Result Value (score or categorical value) -->
        <TextView
            android:id="@+id/tvDimensionValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/netra_text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="8dp" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvDimensionStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status_not_assessed"
            android:text="Not Assessed"
            android:textColor="@color/netra_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Technical Note / Detected Issue -->
    <TextView
        android:id="@+id/tvDimensionNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pending backend model integration"
        android:textColor="@color/netra_text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="5dp" />
</LinearLayout>
