<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concern Type *"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerConcernType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_search"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date First Noticed *"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvConcernDatePicked"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foot Side"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spinnerConcernSide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_search"
            android:padding="8dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Description *"
            android:textColor="@color/netra_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etConcernDescription"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:hint="e.g. Small blister on outer right heel after wearing new walking shoes"
            android:textColor="@color/netra_text_primary"
            android:background="@drawable/bg_netra_search"
            android:padding="12dp"
            android:gravity="top|start"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>

