<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/netra_bg">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER APP BAR
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@color/netra_card_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/netra_deep_navy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kidney Health"
                android:textColor="@color/netra_deep_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organize your kidney health records"
                android:textColor="@color/netra_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_info_circle"
            app:tint="@color/netra_primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRecordHeader"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Add Test"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/netra_primary_teal"
            app:cornerRadius="19dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Last Updated Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvLatestRecordDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Latest test: Checking records…"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnUploadReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📎 Upload Lab Report"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 1: THREE PRIMARY METRIC CARDS
                 ═══════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renal Biomarkers"
                android:textColor="@color/netra_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Card 1: eGFR -->
            <LinearLayout
                android:id="@+id/cardEgfr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_metric_kidney"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="eGFR (Estimated Glomerular Filtration Rate)"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/badgeEgfrSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10sp"
                        android:background="@drawable/bg_pill_status_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvEgfrValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No test record available"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEgfrUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" mL/min/1.73 m²"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEgfrDateAndPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap '+ Add Test' to record your lab test result"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="11.5sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 2: Serum Creatinine -->
            <LinearLayout
                android:id="@+id/cardCreatinine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_lipid"
                        app:tint="@color/netra_secondary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Serum Creatinine"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/badgeCreatinineSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10sp"
                        android:background="@drawable/bg_pill_status_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvCreatinineValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No test record available"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCreatinineUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" mg/dL"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCreatinineDateAndPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap '+ Add Test' to record creatinine level"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="11.5sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 3: UACR -->
            <LinearLayout
                android:id="@+id/cardUacr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_metric_kidney"
                        app:tint="#E67E22" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="UACR (Urine Albumin-to-Creatinine Ratio)"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/badgeUacrSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10sp"
                        android:background="@drawable/bg_pill_status_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvUacrValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No test record available"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUacrUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" mg/g"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUacrDateAndPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap '+ Add Test' to record albumin/creatinine ratio"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="11.5sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 2: TREND CHARTS
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Measurement Trends"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Metric Filter Pills -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTabEgfr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="eGFR"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_mode_pill_selected"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnTabCreatinine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Creatinine"
                            android:textColor="@color/netra_text_secondary"
                            android:textSize="11sp"
                            android:background="@drawable/bg_mode_pill_unselected"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnTabUacr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UACR"
                            android:textColor="@color/netra_text_secondary"
                            android:textSize="11sp"
                            android:background="@drawable/bg_mode_pill_unselected"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <com.emergency.patient.views.HealthTrendChartView
                    android:id="@+id/chartKidneyTrends"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Charts reflect dated user-entered or lab-uploaded values. Units are strictly matched."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="10.5sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 3: KIDNEY TEST HISTORY
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kidney Test History"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 records"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutKidneyHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No kidney test records logged yet. Tap '+ Add Test' above to start tracking your laboratory history."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12.5sp"
                    android:background="@drawable/bg_netra_card"
                    android:padding="20dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 4: REMINDERS
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar_check"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kidney Test Reminders"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/btnAddReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Set Reminder"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutKidneyRemindersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvEmptyReminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No upcoming kidney check reminders scheduled."
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 5: EDUCATIONAL INFORMATION
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_pill_status_teal"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_shield_check_mint"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Understanding Kidney Tests in Diabetes"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• eGFR (Estimated Glomerular Filtration Rate): Estimates kidney filtration efficiency based on blood creatinine, age, and sex.\n\n• Serum Creatinine: Waste product produced by muscle metabolism; elevated blood levels indicate reduced renal clearance.\n\n• UACR (Urine Albumin-to-Creatinine Ratio): Detects early microalbumin leak into urine before filtration drops.\n\nClinical Notice: This record-keeper does not diagnose chronic kidney disease (CKD) or calculate clinical staging. Consult your nephrologist or physician for lab interpretation."
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

