<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A151C"
    android:orientation="vertical">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="#10202A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvViewerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retinal Fundus Image Inspection"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Original resolution • Aspect ratio preserved"
                android:textColor="#A0B0BC"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnViewerClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_netra_search"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Image View Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050B0E">

        <ImageView
            android:id="@+id/ivFullRetina"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Full-resolution retinal fundus photograph" />
    </FrameLayout>

    <!-- Dialog Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="#10202A">

        <TextView
            android:id="@+id/tvViewerMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2048 × 1536 px • 2.4 MB"
            android:textColor="#C8D6E0"
            android:textSize="11.5sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/btnViewerDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_netra_pill_feature"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Close Inspection"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>

