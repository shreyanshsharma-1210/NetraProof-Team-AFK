<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Blood Glucose Reading"
            android:textColor="@color/netra_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record your glucose measurement with exact context and unit."
            android:textColor="@color/netra_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Glucose Value & Unit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glucose Value *"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/etGlucoseValue"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_netra_edittext"
                android:hint="e.g. 110"
                android:inputType="numberDecimal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/netra_text_primary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerGlucoseUnit"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_netra_edittext" />
        </LinearLayout>

        <!-- Reading Context -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reading Context *"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerGlucoseContext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_edittext"
            android:layout_marginBottom="14dp" />

        <!-- Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Measurement Date *"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGlucoseDatePicked"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_netra_edittext"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Select Date"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time (Optional)"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGlucoseTimePicked"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_netra_edittext"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="08:00 AM"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Measurement Source -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Measurement Source"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerGlucoseSource"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_netra_edittext"
            android:layout_marginBottom="14dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clinical / Personal Notes (Optional)"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etGlucoseNotes"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_netra_edittext"
            android:gravity="top|start"
            android:hint="e.g. Measured 15 mins before breakfast"
            android:padding="12dp"
            android:textColor="@color/netra_text_primary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>

