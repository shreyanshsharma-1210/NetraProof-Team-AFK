<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/netra_bg">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER APP BAR
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@color/netra_card_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/netra_deep_navy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foot &amp; Nerve Care"
                android:textColor="@color/netra_deep_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track foot checks and symptoms over time"
                android:textColor="@color/netra_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_info_circle"
            app:tint="@color/netra_primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCheckHeader"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Log Check"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/netra_primary_teal"
            app:cornerRadius="19dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Last Check Date & Quick Actions Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvLatestCheckDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Latest check: Checking records…"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnTrackSymptomQuick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add Symptom"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 1: RECENT FOOT CHECK CARD
                 ═══════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Routine Foot Inspections"
                android:textColor="@color/netra_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/cardRecentCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_metric_foot"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Self-Inspection"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/badgeCheckStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Routine"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10sp"
                        android:background="@drawable/bg_pill_status_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecentCheckSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No foot-check record available"
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvRecentCheckDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap '+ Log Check' to record observations for left, right, or both feet."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:id="@+id/layoutPhotoAttachedIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_shield_check_mint"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Photo record attached securely"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 2: USER-REPORTED SYMPTOMS
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reported Symptoms"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveSymptomsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 active"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:elevation="1dp">

                <LinearLayout
                    android:id="@+id/layoutSymptomsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEmptySymptoms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No symptoms reported. If you experience numbness, tingling, pain, or burning sensations, record them here."
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogNewSymptom"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="+ Track New Symptom"
                    android:textSize="12.5sp"
                    android:textColor="@color/netra_primary_teal"
                    app:strokeColor="@color/netra_primary_teal"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@color/netra_card_surface"
                    app:cornerRadius="10dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 3: FOOT CONCERNS & WOUND RECORDING
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Foot Concerns &amp; Wounds"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecordConcern"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Log Concern"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFootConcernsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvEmptyConcerns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No foot concerns or skin breaks recorded. Tap '+ Log Concern' if you notice blisters, redness, swelling, or cuts."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_netra_card"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 4: PROFESSIONAL ASSESSMENT GUIDANCE (RED FLAGS)
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quality_card_warning"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info_circle"
                        app:tint="@color/netra_warning" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="When to Seek Urgent Medical Care"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seek prompt professional evaluation if you observe any of the following:\n\n• Rapidly worsening redness, heat, or swelling\n• Skin breaks or sores with discharge or foul odor\n• Non-healing cuts or dark discoloration of toes\n• Fever, chills, or sudden loss of sensation\n\nClinical Notice: This tool records observations for personal review and does NOT diagnose neuropathy or wound infection. Never delay professional medical care while waiting for app reminders."
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 5: FOOT-CARE REMINDERS
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar_check"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Foot Care Reminders"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/btnAddFootReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Set Reminder"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutFootRemindersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvEmptyFootReminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No upcoming foot inspections scheduled."
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 6: CHRONOLOGICAL FOOT & NERVE TIMELINE
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Foot &amp; Nerve History"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFootHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 records"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFootHistoryTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvEmptyFootTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No foot checks or symptoms logged yet."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12.5sp"
                    android:background="@drawable/bg_netra_card"
                    android:padding="20dp"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
