<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/netra_bg">

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER APP BAR
         ═══════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@color/netra_card_surface"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/netra_deep_navy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heart &amp; Vascular"
                android:textColor="@color/netra_deep_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep your cardiovascular records organized"
                android:textColor="@color/netra_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_info_circle"
            app:tint="@color/netra_primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRecordHeader"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Log Reading"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/netra_primary_teal"
            app:cornerRadius="19dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Last Updated Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvLatestRecordDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Latest check: Checking records…"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnAddLipidReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Add Lipid Panel"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 1: CARDIOVASCULAR METRIC CARDS
                 ═══════════════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiovascular Health Overview"
                android:textColor="@color/netra_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Card 1: Blood Pressure -->
            <LinearLayout
                android:id="@+id/cardBp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_blood_pressure"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blood Pressure (Systolic / Diastolic)"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/badgeBpSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10sp"
                        android:background="@drawable/bg_pill_status_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvBpValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No blood pressure reading"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBpUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" mmHg"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBpDateAndPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to log your latest systolic and diastolic readings"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="11.5sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Card 2: Lipid Profile Overview -->
            <LinearLayout
                android:id="@+id/cardLipids"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_lipid"
                        app:tint="#E67E22" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lipid Profile"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/badgeLipidSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lab Report"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10sp"
                        android:background="@drawable/bg_pill_status_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutLipidValuesGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvLipidSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No lipid test record available"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLipidDateAndLab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to log Total Cholesterol, LDL, HDL, and Triglycerides"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="11.5sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 2: TREND VISUALIZATION
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cardiovascular Trends"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Tabs: Blood Pressure vs Total Cholesterol -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnTabBp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blood Pressure"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_mode_pill_selected"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btnTabLipids"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lipids (Total)"
                            android:textColor="@color/netra_text_secondary"
                            android:textSize="11sp"
                            android:background="@drawable/bg_mode_pill_unselected"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <com.emergency.patient.views.HealthTrendChartView
                    android:id="@+id/chartHeartTrends"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

                <!-- Legend -->
                <LinearLayout
                    android:id="@+id/layoutBpLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="4dp"
                        android:background="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Systolic (mmHg)   "
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="4dp"
                        android:background="#E67E22" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Diastolic (mmHg)"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 3: RELEVANT HEALTH HISTORY
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Relevant Cardiovascular History"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEditCardioHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCardioHistoryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No user-provided cardiovascular history noted. Tap 'Edit' to record self-reported conditions or clinician history."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 4: MEASUREMENT HISTORY (BP & LIPIDS)
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cardiovascular Records"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeartHistoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 records"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHeartHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyHeartHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No blood pressure or lipid records logged yet. Tap '+ Log Reading' to begin."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12.5sp"
                    android:background="@drawable/bg_netra_card"
                    android:padding="20dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 5: REMINDERS
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_netra_card"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar_check"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Heart Health Reminders"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/btnAddHeartReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Set Reminder"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHeartRemindersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvEmptyHeartReminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No upcoming blood pressure or lipid checks scheduled."
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════
                 SECTION 6: EDUCATIONAL INFORMATION
                 ═══════════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_pill_status_teal"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_shield_check_mint"
                        app:tint="@color/netra_primary_teal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Understanding Cardiovascular Health"
                        android:textColor="@color/netra_deep_navy"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Blood Pressure: Systolic measures arterial pressure during heart contraction; Diastolic measures resting pressure between beats. Repeated readings provide an accurate baseline.\n\n• Lipid Profile: Evaluates circulating cholesterol and fats (LDL, HDL, Triglycerides). Diabetes management routinely monitors lipids to support vascular health.\n\nClinical Notice: This organizer is not an emergency monitor and does not predict heart attacks or strokes. For chest discomfort, shortness of breath, or medical emergencies, seek immediate medical care."
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="11.5sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

