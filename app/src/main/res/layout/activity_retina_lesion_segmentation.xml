<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/netra_bg">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/netra_card_surface"
        android:elevation="2dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_netra_search"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/netra_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_netraproof_logo"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NetraProof"
                    android:textColor="@color/netra_primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvSessionIdBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION: NP-SCR-00001"
                    android:textColor="@color/netra_deep_navy"
                    android:background="@drawable/bg_netra_badge_navy"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retinal Lesion Analysis"
                android:textColor="@color/netra_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI-powered retinal lesion segmentation"
                android:textColor="@color/netra_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_netra_search"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_info_circle"
                app:tint="@color/netra_primary_teal" />
        </FrameLayout>

        <!-- Patient Profile Avatar -->
        <FrameLayout
            android:id="@+id/btnProfileAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar_profile_mint"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="NP"
                android:textColor="@color/netra_deep_navy"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 5-Stage Stepper Tracker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quality_card_pending"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SCREENING PIPELINE PROGRESS"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvPipelineStageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stage 4 of 5"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <!-- Stage 1: Upload (Done) -->
                    <LinearLayout
                        android:id="@+id/rowStage1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_stage_completed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload"
                            android:textColor="@color/netra_text_primary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Done"
                            android:textColor="@color/netra_success"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1.5dp"
                        android:background="@color/netra_success" />

                    <!-- Stage 2: Quality (Done) -->
                    <LinearLayout
                        android:id="@+id/rowStage2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_stage_completed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quality"
                            android:textColor="@color/netra_text_primary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Passed"
                            android:textColor="@color/netra_success"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1.5dp"
                        android:background="@color/netra_success" />

                    <!-- Stage 3: DR Grading (Done) -->
                    <LinearLayout
                        android:id="@+id/rowStage3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_stage_completed" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DR Grade"
                            android:textColor="@color/netra_text_primary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvStage3Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Done"
                            android:textColor="@color/netra_success"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1.5dp"
                        android:background="@color/netra_primary_teal" />

                    <!-- Stage 4: Segmentation (Active) -->
                    <LinearLayout
                        android:id="@+id/rowStage4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivStage4Icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_stage_in_progress" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lesions"
                            android:textColor="@color/netra_text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvStage4Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textColor="@color/netra_primary_teal"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="16dp"
                        android:layout_height="1.5dp"
                        android:background="@color/netra_border" />

                    <!-- Stage 5: Report (Pending) -->
                    <LinearLayout
                        android:id="@+id/rowStage5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/ivStage5Icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_stage_pending" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Report"
                            android:textColor="@color/netra_text_secondary"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvStage5Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textColor="@color/netra_text_secondary"
                            android:textSize="8.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Mode Selector Switcher (Interactive Overlay / Side-by-Side / Before-After) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/btnModeOverlay"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Overlay"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_mode_pill_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnModeSideBySide"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="Side-by-Side"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_mode_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/btnModeBeforeAfter"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.1"
                    android:gravity="center"
                    android:text="Before / After"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="12sp"
                    android:background="@drawable/bg_mode_pill_unselected"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Interactive Retina Canvas Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="#0A151C"
                android:layout_marginBottom="6dp">

                <!-- Custom Canvas View -->
                <com.emergency.patient.views.RetinaOverlayView
                    android:id="@+id/retinaOverlayView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Floating Canvas Inspection Controls (Top-Right) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp">

                    <FrameLayout
                        android:id="@+id/btnZoomIn"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_netra_search"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_zoom_in"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnZoomOut"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_netra_search"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_zoom_out"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnResetZoom"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_netra_search"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="1:1"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnFullscreen"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_netra_search"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_fullscreen"
                            app:tint="#FFFFFF" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Floating Before/After Toggle Overlay (Bottom Center, only visible in Before/After mode) -->
                <LinearLayout
                    android:id="@+id/layoutBeforeAfterBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_netra_badge_navy"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnToggleBefore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" | "
                        android:textColor="#71818D"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnToggleAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Overlay"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Image Metadata Summary Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tvImageDimensions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dimensions: 2048 × 1536 px"
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvImageResolutionTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aspect Ratio Preserved • fitCenter"
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Opacity Control Slider Panel -->
            <LinearLayout
                android:id="@+id/cardOpacityControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_lesion_layer_card"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_tune_slider"
                        app:tint="@color/netra_primary_teal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Overlay Opacity"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOpacityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="65%"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/btnResetOpacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reset (65%)"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="11sp"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="65"
                    android:progressTint="@color/netra_primary_teal"
                    android:thumbTint="@color/netra_primary_teal"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10% (Subtle)"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% (Dense)"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick Action: Proceed directly to Stage 05 AI Screening Report -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickGenerateReport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Generate AI Screening Report (Stage 05) →"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/netra_primary_teal"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Segmentation Layers Section Header & Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Segmentation Layers"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Independent lesion categories (U-Net + SE-ResNeXt50)"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnShowAllLayers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show All"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnHideAllLayers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hide All"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="11.5sp"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Layer 1: Cotton Wool Spots -->
            <include
                android:id="@+id/layerCottonWool"
                layout="@layout/item_lesion_layer_toggle" />

            <!-- Layer 2: Hard Exudates -->
            <include
                android:id="@+id/layerHardExudates"
                layout="@layout/item_lesion_layer_toggle" />

            <!-- Layer 3: Hemorrhages -->
            <include
                android:id="@+id/layerHemorrhages"
                layout="@layout/item_lesion_layer_toggle" />

            <!-- Layer 4: Microaneurysms -->
            <include
                android:id="@+id/layerMicroaneurysms"
                layout="@layout/item_lesion_layer_toggle" />

            <!-- Segmentation Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quality_card_passed"
                android:padding="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Segmentation Summary"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badgeSummaryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Pending"
                        android:textColor="@color/netra_deep_navy"
                        android:background="@drawable/bg_pill_status_not_assessed"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/netra_border"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <!-- Row 1: Model Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Model Architecture"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSummaryModelName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="U-Net + SE-ResNeXt50"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: Model Version -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Model Version"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSummaryModelVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NetraProof-UNet-SEResNeXt50-v1.0"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Row 3: Inference Timestamp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Analysis Timestamp"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvSummaryTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oct 31, 2026 • 23:40 IST"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Row 4: Supported Categories -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Supported Categories"
                        android:textColor="@color/netra_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Distinct Classes"
                        android:textColor="@color/netra_primary_teal"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Model Information & Independence Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quality_card_pending"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_smart_chip"
                        app:tint="@color/netra_primary_teal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="About Lesion Segmentation"
                        android:textColor="@color/netra_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="U-Net + SE-ResNeXt50"
                        android:textColor="@color/netra_primary_teal"
                        android:background="@drawable/bg_pill_status_teal"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The segmentation model analyzes the retinal image to identify and visually represent selected lesion patterns across four supported categories: Cotton Wool Spots, Hard Exudates, Hemorrhages, and Microaneurysms."
                    android:textColor="@color/netra_text_primary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Important: Lesion segmentation is an independent AI analysis stage. Its visual masks do not directly explain or validate the DR severity grade generated by the separate grading model."
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Downstream Report Generation Card & CTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_quality_card_passed"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Stage — AI Screening Report"
                    android:textColor="@color/netra_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Combine the available DR grading result and independent lesion segmentation output into a structured screening report."
                    android:textColor="@color/netra_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateReport"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Generate AI Screening Report →"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/netra_primary_teal"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Clinical Safety Disclaimer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill_status_teal"
                android:padding="12dp"
                android:gravity="top">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_check_mint"
                    app:tint="@color/netra_primary_teal"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI-generated lesion segmentation is intended to support retinal image review. Segmentation outputs are not a confirmed diagnosis and must be interpreted by a qualified eye-care professional."
                    android:textColor="@color/netra_deep_navy"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

