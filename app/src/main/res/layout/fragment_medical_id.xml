<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_medical_id.xml — NetraProof Virtual Medical ID Card & Emergency Pass
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FCF9">

    <!-- ─── Main Content ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Virtual Medical ID"
                    android:textColor="#087F68"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant First-Responder Triage Pass"
                    android:textColor="#687790"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● VERIFIED"
                android:textColor="#087F68"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_med_summary_scheduled"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Scrollable Card Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="110dp">

                <!-- ═══════════════════════════════════════════════════
                     VIRTUAL HEALTH ID CARD
                     ═══════════════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_medical_id_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:elevation="6dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_smart_chip"
                            android:contentDescription="Smart Chip" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NETRAPROOF HEALTH PASS"
                                android:textColor="#087F68"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.04" />

                            <TextView
                                android:id="@+id/tvCardUniqueId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SANJ-2026-IND-7492"
                                android:textColor="#0D2140"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="22dp"
                            android:src="@drawable/app_header_logo"
                            android:scaleType="fitEnd"
                            android:adjustViewBounds="true"
                            android:contentDescription="Logo Watermark" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D1E7DD"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Card Center: Photo + Info + QR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Profile Photo -->
                        <FrameLayout
                            android:layout_width="74dp"
                            android:layout_height="74dp"
                            android:background="@drawable/bg_avatar_circle">

                            <ImageView
                                android:id="@+id/iv_avatar_med_id"
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_blank_profile" />
                        </FrameLayout>

                        <!-- Name & Basic Details -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/tv_patient_name_med_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Patient Name"
                                android:textColor="#0D2140"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tv_patient_age_med_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="32 yrs • Male"
                                android:textColor="#687790"
                                android:textSize="11.5sp"
                                android:layout_marginTop="2dp" />

                            <!-- Blood Group Badge -->
                            <TextView
                                android:id="@+id/tv_blood_group_med_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blood Group: O+"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_pill_status_high"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- Tappable QR Box -->
                        <FrameLayout
                            android:id="@+id/card_qr_tap"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_card_white"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/iv_qr_code_med_id"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:contentDescription="Emergency QR Code" />
                        </FrameLayout>

                    </LinearLayout>

                    <!-- Medical Details Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFFFFF"
                        android:padding="10dp"
                        android:layout_marginTop="12dp">

                        <!-- Allergies & Conditions -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚠️ ALLERGIES"
                                    android:textColor="#DC2626"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMedIdAllergies"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Penicillin, Dust"
                                    android:textColor="#0D2140"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🩺 CONDITIONS"
                                    android:textColor="#2563EB"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMedIdConditions"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hypertension"
                                    android:textColor="#0D2140"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Organ Donor & Emergency Contact -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🫀 ORGAN DONOR"
                                    android:textColor="#087F68"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMedIdDonor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="YES • REGISTERED"
                                    android:textColor="#087F68"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📞 EMERGENCY CONTACT"
                                    android:textColor="#D97706"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvMedIdEmergencyContact"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+91 98765 43210"
                                    android:textColor="#0D2140"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════
                     SLIDE TO SOS / EMERGENCY AMBULANCE
                     ═══════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Emergency Dispatch"
                    android:textColor="#0D2140"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp" />

                <!-- Slide Track Container -->
                <FrameLayout
                    android:id="@+id/slider_container_med"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_slider_track"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tv_slide_hint_med"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Slide to Trigger SOS ❯❯❯"
                        android:textColor="#DC2626"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/slider_thumb_med"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_slider_thumb"
                        android:elevation="4dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_action_sos"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                </FrameLayout>

                <!-- ═══════════════════════════════════════════════════
                     UPLOADED DOCUMENTS SECTION
                     ═══════════════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📁 Uploaded Documents"
                        android:textColor="#0D2140"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_upload_new_doc_med_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Upload New"
                        android:textColor="#087F68"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_pill_status_normal" />
                </LinearLayout>

                <!-- Document List Container -->
                <LinearLayout
                    android:id="@+id/ll_med_id_documents_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/ll_med_id_docs_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#687790" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No health documents uploaded yet"
                        android:textColor="#0D2140"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload medical reports, prescriptions, or lab tests to enable AI clinical analysis."
                        android:textColor="#687790"
                        android:textSize="11.5sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Bottom spacer so content isn't obscured by floating navbar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="90dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ─── Countdown Overlay ────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/fl_med_countdown_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6DC2626"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_med_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_med_countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispatching Emergency SOS..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_cancel_med_sos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANCEL SOS"
                android:textColor="#DC2626"
                android:backgroundTint="#FFFFFF"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ─── QR Fullscreen Overlay ────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/fl_qr_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_white"
            android:padding="24dp">

            <ImageView
                android:id="@+id/iv_qr_fullscreen"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap anywhere to dismiss"
                android:textColor="#687790"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
